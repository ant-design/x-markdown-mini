{
  "name": "@ant-design/x-markdown-mini",
  "version": "0.1.0",
  "description": "多小程序场景下的高性能、强扩展、流式友好的 Markdown 渲染器",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "miniprogram": "dist",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./alipay/markdown": "./dist/components/alipay/markdown/index.js",
    "./alipay/richtext": "./dist/components/alipay/richtext/index.js",
    "./wechat/markdown": "./dist/components/wechat/markdown/index.js",
    "./wechat/richtext": "./dist/components/wechat/richtext/index.js",
    "./components/*": "./dist/components/*"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/patch-modern-regex.mjs && node scripts/copy-component-assets.mjs",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "docs": "npm run build && cd docs-site && npm run dev",
    "docs:build": "npm run build && cd docs-site && npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "markdown",
    "miniprogram",
    "wechat",
    "alipay",
    "douyin",
    "rich-text"
  ],
  "license": "MIT",
  "devDependencies": {
    "marked": "^18.0.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ant-design/x-markdown-mini.git"
  },
  "homepage": "https://github.com/ant-design/x-markdown-mini#readme",
  "bugs": {
    "url": "https://github.com/ant-design/x-markdown-mini/issues"
  }
}
