{
  "name": "@ant-design/x-markdown-mini",
  "version": "0.1.0-beta.9",
  "description": "多小程序场景下的高性能、强扩展、流式友好的 Markdown 渲染器",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "miniprogram": "dist/miniprogram_dist",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./es/*": "./dist/es/*",
    "./shared/*": "./dist/shared/*",
    "./components/*": "./dist/components/*",
    "./plugins/Latex": {
      "types": "./dist/plugins/Latex/index.d.ts",
      "import": "./dist/plugins/Latex/index.mjs",
      "require": "./dist/plugins/Latex/index.js"
    },
    "./plugins/CodeHighlight": {
      "types": "./dist/plugins/CodeHighlight/index.d.ts",
      "import": "./dist/plugins/CodeHighlight/index.mjs",
      "require": "./dist/plugins/CodeHighlight/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/generate-katex-fonts.mjs && node scripts/clean.mjs && tsup && node scripts/patch-modern-regex.mjs && node scripts/copy-miniprogram-dist.mjs && node scripts/copy-component-assets.mjs && node scripts/prepare-publish.mjs",
    "release": "npm run build && npm publish ./dist",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "test": "vitest run --coverage",
    "test:ci": "vitest --run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "check:test-rate": "node scripts/check-test-pass-rate.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "bench": "tsx benchmark/run.ts",
    "bench:check": "npm run bench && node scripts/check-bench.mjs --threshold 0.10",
    "bench:update": "npm run bench && node scripts/bench-update.mjs",
    "bench:compare": "tsx benchmark/compare.ts",
    "check:examples": "node scripts/check-examples.mjs",
    "sync:examples": "node scripts/sync-example-sample.mjs && node examples/wechat/scripts/sync-npm-fixtures.mjs && node examples/alipay/scripts/sync-local-package.mjs && node examples/alipay/scripts/patch-mp-html.mjs",
    "patch:examples": "node examples/wechat/scripts/sync-npm-fixtures.mjs && node examples/alipay/scripts/sync-local-package.mjs && node examples/alipay/scripts/patch-mp-html.mjs",
    "lint": "eslint src --ext .ts",
    "docs": "npm run build && cd docs-site && npm run dev",
    "docs:build": "npm run build && cd docs-site && npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "markdown",
    "miniprogram",
    "wechat",
    "alipay",
    "douyin",
    "mini-program-nodes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "es-check": "^7.2.1",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "marked": "^18.0.3",
    "mini-html-parser2": "^0.3.0",
    "mp-html": "^2.5.2",
    "remark": "^15.0.1",
    "remend": "^1.3.0",
    "tinybench": "^3.0.0",
    "towxml": "^3.0.6",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ant-design/x-markdown-mini.git"
  },
  "homepage": "https://github.com/ant-design/x-markdown-mini#readme",
  "bugs": {
    "url": "https://github.com/ant-design/x-markdown-mini/issues"
  }
}
