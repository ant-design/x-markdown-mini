.cd {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  margin: 0 4rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  border: 1rpx solid #ffccc7;
  vertical-align: middle;
}
.cd--done {
  background: #f2f3f5;
  border-color: #e5e6eb;
}
.cd__label { font-size: 24rpx; color: #cf1322; }
.cd--done .cd__label { color: #86909c; }
.cd__time {
  font-size: 24rpx;
  font-weight: 600;
  color: #cf1322;
  font-variant-numeric: tabular-nums;
}
.cd--done .cd__time { color: #86909c; }
