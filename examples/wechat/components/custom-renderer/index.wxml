<!--
  自定义组件分发器（dispatcher）。微信不支持 slot-scope，所以由它充当 markdown
  抽象节点 <custom-slot> 的具体实现：拿到 node（MiniNode），按 node.name / node.tag
  分发到页面已注册的真实组件。
-->
<countdown
  wx:if="{{node.name === 'countdown'}}"
  seconds="{{node.attrs.seconds}}"
  label="{{node.attrs.label}}"
/>
<footnote-ref
  wx:elif="{{node.name === 'footnote'}}"
  label="{{node.attrs.label}}"
  content="{{node.attrs.content}}"
/>
<view wx:else class="custom-fallback">[未注册自定义组件: {{node.name}}]</view>
