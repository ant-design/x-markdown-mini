<view class="page">
  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollAnchor}}"
    scroll-with-animation
  >
    <view wx:if="{{!messages.length}}" class="empty">
      <view class="empty-title">x-markdown-mini · WeChat Agent</view>
      <view class="empty-sub">输入消息，和真实模型聊聊吧</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="{{item.id}}"
      class="row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
    >
      <view wx:if="{{item.role === 'user'}}" class="bubble bubble-user">{{item.content}}</view>
      <view wx:else class="bubble bubble-ai">
        <text wx:if="{{!item.content}}" class="typing">思考中…</text>
        <markdown wx:else content="{{item.content}}" streaming="{{item.streaming}}" selectable="{{true}}" />
      </view>
    </view>

    <view id="{{scrollAnchor}}" class="anchor"></view>
  </scroll-view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{input}}"
      placeholder="输入消息，和 Agent 聊聊…"
      confirm-type="send"
      disabled="{{sending}}"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <button class="composer-send" type="primary" size="mini" loading="{{sending}}" bindtap="onSend">
      发送
    </button>
  </view>
</view>
