<view class="page">
  <view class="topbar">
    <view>
      <view class="title">Agent Demo</view>
      <view class="subtitle">x-markdown-mini</view>
    </view>
    <button wx:if="{{messages.length}}" class="ghost-button" size="mini" bindtap="onReset">清空</button>
  </view>

  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollAnchor}}"
    scroll-with-animation
  >
    <view wx:if="{{!messages.length}}" class="empty">
      <view class="empty-title">微信小程序 Markdown Agent</view>
      <view class="empty-sub">Agent 已就绪</view>
      <view class="suggestions">
        <button
          wx:for="{{suggestions}}"
          wx:key="*this"
          class="suggestion"
          size="mini"
          data-text="{{item}}"
          bindtap="onTapSuggestion"
        >
          {{item}}
        </button>
      </view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="{{item.id}}"
      class="row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
    >
      <view wx:if="{{item.role === 'user'}}" class="bubble bubble-user">
        <text selectable>{{item.content}}</text>
      </view>
      <view wx:else class="reply-ai">
        <view wx:if="{{!item.content}}" class="typing">
          <text class="dot"></text>
          <text class="dot"></text>
          <text class="dot"></text>
        </view>
        <markdown
          wx:else
          content="{{item.content}}"
          streaming="{{item.streaming}}"
          selectable="{{true}}"
        />
      </view>
    </view>

    <view id="{{scrollAnchor}}" class="anchor"></view>
  </scroll-view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{input}}"
      placeholder="输入消息"
      confirm-type="send"
      disabled="{{sending}}"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <button class="composer-send" type="primary" size="mini" loading="{{sending}}" bindtap="onSend">发送</button>
  </view>
</view>
