/* 组件接入无需 @import 任何插件/组件样式：<markdown> 自带。这里只放页面布局。 */
.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}
.stream-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  background: #f7f9fc;
  border: 2rpx solid #e8edf5;
  border-radius: 16rpx;
}
.stream-copy {
  display: flex;
  flex-direction: column;
}
.stream-title {
  color: #1d2129;
  font-size: 28rpx;
  font-weight: 600;
}
.stream-status {
  margin-top: 4rpx;
  color: #86909c;
  font-size: 22rpx;
}
.stream-options {
  margin: -12rpx 0 24rpx;
  padding: 8rpx 24rpx;
  background: #f7f9fc;
  border: 2rpx solid #e8edf5;
  border-radius: 16rpx;
}
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  color: #4e5969;
  font-size: 24rpx;
}
.option-row + .option-row {
  border-top: 2rpx solid #e8edf5;
}
.note {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #eef6ff;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4e5969;
}
.note-tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 12rpx;
  background: #165dff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.card {
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
