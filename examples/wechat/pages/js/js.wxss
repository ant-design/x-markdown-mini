/* 直接用底层 MiniNodeRenderer 时，markdown 元素样式（标题/代码卡片/表格/复制按钮等）
   不会自动带上，需自行 @import。微信 WXSS @import 只认相对路径，指向「构建 npm」产物
   miniprogram_npm。Markdown/index.wxss 已内含 CodeHighlight + Latex(含字体) 样式，引一处即可。 */
@import "../../miniprogram_npm/@ant-design/x-markdown-mini/components/Markdown/index.wxss";

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}
.note {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fff7e8;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4e5969;
}
.note-tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 12rpx;
  background: #ff7d00;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.card {
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
