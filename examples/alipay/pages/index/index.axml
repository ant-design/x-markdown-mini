<view class="page">
  <view class="topbar">
    <view>
      <view class="title">Agent Demo</view>
      <view class="subtitle">x-markdown-mini · Alipay</view>
    </view>
    <button a:if="{{messages.length}}" class="ghost-button" size="mini" onTap="onReset">清空</button>
  </view>

  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollAnchor}}"
    scroll-with-animation
  >
    <view a:if="{{!messages.length}}" class="empty">
      <view class="empty-title">支付宝小程序 Markdown Agent</view>
      <view class="empty-sub">Agent 已就绪</view>
      <view class="suggestions">
        <button
          a:for="{{suggestions}}"
          a:key="id"
          class="suggestion"
          size="mini"
          data-text="{{item.text}}"
          onTap="onTapSuggestion"
        >
          {{item.text}}
        </button>
      </view>
    </view>

    <view
      a:for="{{messages}}"
      a:key="id"
      id="{{item.id}}"
      class="row {{item.rowClass}}"
    >
      <view a:if="{{item.isUser}}" class="bubble bubble-user">
        <text selectable>{{item.content}}</text>
      </view>
      <view a:else class="reply-ai">
        <view a:if="{{!item.content}}" class="typing">
          <text class="dot"></text>
          <text class="dot"></text>
          <text class="dot"></text>
        </view>
        <markdown
          a:else
          content="{{item.content}}"
          streaming="{{item.streaming}}"
          footnote="{{true}}"
          selectable="{{true}}"
        >
          <view slot-scope="prop" class="fn">
            <text
              class="fn__marker"
              data-label="{{prop.data.attrs.label}}"
              data-content="{{prop.data.attrs.content}}"
              onTap="onFootnoteTap"
            >[{{prop.data.attrs.label}}]</text>
          </view>
        </markdown>
      </view>
    </view>

    <view id="{{scrollAnchor}}" class="anchor"></view>
  </scroll-view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{input}}"
      placeholder="输入消息"
      confirm-type="send"
      disabled="{{sending}}"
      onInput="onInput"
      onConfirm="onSend"
    />
    <button
      class="composer-send"
      type="primary"
      size="mini"
      loading="{{sending}}"
      onTap="onSend"
    >
      发送
    </button>
  </view>

  <view
    a:if="{{activeFootnote}}"
    class="fn__pop"
    onTap="onCloseFootnote"
  >
    <view class="fn__bubble" catchTap="noop">
      <view class="fn__title">脚注 {{activeFootnote.label}}</view>
      <text class="fn__text">{{activeFootnote.content}}</text>
    </view>
  </view>
</view>
