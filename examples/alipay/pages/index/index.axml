<view class="page">
  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollAnchor}}"
    scroll-with-animation
  >
    <view a:if="{{!messages.length}}" class="empty">
      <view class="empty-title">x-markdown-mini · Alipay Agent</view>
      <view class="empty-sub">npm 包组件渲染 Agent Markdown，setTimeout 模拟模型返回</view>
      <view class="prompt-list">
        <view
          a:for="{{prompts}}"
          a:key="id"
          class="prompt-chip {{promptDisabledClass}}"
          data-text="{{item.text}}"
          onTap="onPromptTap"
        >
          {{item.text}}
        </view>
      </view>
    </view>

    <view
      a:for="{{messages}}"
      a:key="id"
      id="{{item.id}}"
      class="row {{item.rowClass}}"
    >
      <view a:if="{{item.isUser}}" class="bubble bubble-user">{{item.content}}</view>
      <view a:else class="bubble bubble-ai">
        <text a:if="{{!item.content}}" class="typing">思考中…</text>
        <markdown a:else content="{{item.content}}" streaming="{{item.streaming}}" selectable="{{true}}" />
      </view>
    </view>

    <view id="{{scrollAnchor}}" class="anchor"></view>
  </scroll-view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{input}}"
      placeholder="输入消息，和 Agent 聊聊…"
      confirm-type="send"
      disabled="{{sending}}"
      onInput="onInput"
      onConfirm="onSend"
    />
    <button class="composer-send" type="primary" size="mini" loading="{{sending}}" onTap="onSend">
      发送
    </button>
  </view>
</view>
