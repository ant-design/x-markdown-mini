<view class="page">
  <view class="header">
    <view class="title">脚注 · Alipay</view>
    <view class="hint">footnote 扩展（[^标签:内容]）+ 作用域插槽 + popover</view>
  </view>

  <view class="card">
    <!--
      footnote="{{true}}" 开启内置脚注扩展：markdown 里的 [^1:...] 被识别为
      footnote 节点，经作用域插槽交给页面注册的 footnote-ref 渲染 marker + popover。
    -->
    <markdown content="{{content}}" footnote="{{true}}">
      <view slot-scope="prop">
        <footnote-ref
          a:if="{{prop.data.tag === 'footnote'}}"
          label="{{prop.data.attrs.label}}"
          content="{{prop.data.attrs.content}}"
        />
      </view>
    </markdown>
  </view>
</view>
