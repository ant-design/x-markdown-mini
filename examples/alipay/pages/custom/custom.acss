.page { padding: 24rpx; }
.header { margin-bottom: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.hint { font-size: 24rpx; color: #86909c; margin-top: 6rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  line-height: 1.7;
}
.logs {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.logs__title { font-size: 26rpx; font-weight: 600; margin-bottom: 8rpx; }
.logs__item { font-size: 24rpx; color: #4e5969; padding: 4rpx 0; }
