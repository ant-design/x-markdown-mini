<view class="page">
  <view class="hero">
    <view class="hero-title">x-markdown-mini</view>
    <view class="hero-sub">小程序 Markdown 渲染 · 两种接入方式</view>
  </view>

  <view class="cards">
    <view
      a:for="{{entries}}"
      a:key="id"
      class="card"
      hover-class="card-hover"
      data-url="{{item.url}}"
      onTap="onTapEntry"
    >
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.desc}}</view>
      <view class="card-arrow">→</view>
    </view>
  </view>
</view>
