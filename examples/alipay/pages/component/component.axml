<view class="page">
  <view class="stream-control">
    <view class="stream-copy">
      <text class="stream-title">AI 流式渲染</text>
      <text class="stream-status">{{streamingStatus}}</text>
    </view>
    <switch checked="{{streamingEnabled}}" color="#165dff" onChange="onStreamingChange" />
  </view>

  <view class="stream-options">
    <view class="option-row">
      <text>语义分块</text>
      <switch checked="{{semanticEnabled}}" color="#165dff" onChange="onSemanticChange" />
    </view>
    <view class="option-row">
      <text>文字动画</text>
      <switch checked="{{animationEnabled}}" color="#165dff" onChange="onAnimationChange" />
    </view>
  </view>

  <view class="note">
    <text class="note-tag">组件接入</text>
    一行 usingComponents 引入 markdown，加 latex / highlight 属性即开启公式与代码高亮。
    页面无需 require 插件、无需 @import 样式。
  </view>

  <view class="card">
    <markdown
      content="{{streamContent}}"
      streaming="{{streamingConfig}}"
      latex="{{true}}"
      highlight="{{true}}"
    />
  </view>
</view>
