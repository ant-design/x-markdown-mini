/* 组件接入无需 @import 任何插件/组件样式：markdown 组件自带。这里只放页面布局。 */
.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}
.note {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #eef6ff;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4e5969;
}
.note-tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 12rpx;
  background: #165dff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.card {
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
