.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}
.header {
  margin: 16rpx 4rpx 32rpx;
}
.title {
  display: block;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1d2129;
}
.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #4e5969;
}
.panel,
.result-card,
.render-panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.section-title {
  margin-bottom: 18rpx;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #1d2129;
}
.segmented {
  display: flex;
}
.renderer-list {
  display: flex;
  flex-direction: column;
}
.segment {
  flex: 1;
  height: 72rpx;
  margin-right: 16rpx;
  padding: 0;
  border-radius: 8rpx;
  border: 1rpx solid #e5e6eb;
  background: #ffffff;
  color: #4e5969;
  font-size: 26rpx;
  line-height: 72rpx;
}
.renderer-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 96rpx;
  height: auto;
  margin: 0 0 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  border: 1rpx solid #e5e6eb;
  background: #ffffff;
  color: #1d2129;
  line-height: 1.4;
  text-align: left;
}
.renderer-option:last-child {
  margin-bottom: 0;
}
.renderer-active {
  border-color: #ff7d00;
  background: #fff7e8;
}
.renderer-name {
  display: block;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 600;
}
.renderer-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #86909c;
}
.segment:last-child {
  margin-right: 0;
}
.segment-active {
  border-color: #ff7d00;
  background: #fff7e8;
  color: #c25700;
  font-weight: 600;
}
.hint,
.summary,
.note,
.scope,
.skip-reason,
.error {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #86909c;
}
.hint {
  margin-top: 14rpx;
}
.run-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  height: auto;
  margin: 28rpx 0 18rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #ff7d00;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}
.summary {
  margin-bottom: 24rpx;
}
.result-head,
.research-head {
  display: flex;
  align-items: center;
}
.rank {
  width: 72rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #1d2129;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
}
.result-name {
  flex: 1;
  margin-left: 18rpx;
}
.name,
.research-name,
.skip-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #1d2129;
}
.stage {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #86909c;
}
.metrics {
  display: flex;
  margin-top: 24rpx;
  border-top: 1rpx solid #f2f3f5;
}
.stream-metrics {
  margin-top: 12rpx;
}
.metric {
  flex: 1;
  padding-top: 20rpx;
  min-width: 0;
}
.metric-value {
  display: block;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #1d2129;
  word-break: break-all;
}
.metric-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #86909c;
}
.skip-row,
.research-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #f2f3f5;
}
.skip-row:first-of-type,
.research-row:first-of-type {
  border-top: 0;
}
.badge {
  margin-left: auto;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
  color: #4e5969;
  font-size: 20rpx;
  line-height: 1.2;
}
.scope {
  margin-top: 8rpx;
  color: #4e5969;
}
.note {
  margin-top: 6rpx;
}
.error {
  margin-top: 16rpx;
  color: #d93026;
}
.render-panel {
  min-height: 240rpx;
}
