/* 直接用底层 MiniNodeRenderer 时，markdown 元素样式（标题/代码卡片/表格/复制按钮等）
   不会自动带上，需自行 @import。包以 dist 内容即包根发布，子路径无 dist/ 段。
   Markdown/index.acss 已内含 CodeHighlight + Latex(含字体) 样式，引一处即可。 */
@import "@ant-design/x-markdown-mini/components/Markdown/index.acss";

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}
.stream-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  background: #f9f8f5;
  border: 2rpx solid #eee9df;
  border-radius: 16rpx;
}
.stream-copy {
  display: flex;
  flex-direction: column;
}
.stream-title {
  color: #1d2129;
  font-size: 28rpx;
  font-weight: 600;
}
.stream-status {
  margin-top: 4rpx;
  color: #86909c;
  font-size: 22rpx;
}
.stream-options {
  margin: -12rpx 0 24rpx;
  padding: 8rpx 24rpx;
  background: #f9f8f5;
  border: 2rpx solid #eee9df;
  border-radius: 16rpx;
}
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  color: #4e5969;
  font-size: 24rpx;
}
.option-row + .option-row {
  border-top: 2rpx solid #eee9df;
}
.note {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fff7e8;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4e5969;
}
.note-tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 12rpx;
  background: #ff7d00;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.card {
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
