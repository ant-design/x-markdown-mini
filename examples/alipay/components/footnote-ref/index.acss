.fn {
  display: inline;
  position: relative;
}
.fn__marker {
  color: #1677ff;
  font-size: 22rpx;
  vertical-align: super;
  padding: 0 2rpx;
}
/* popover：固定居中浮层 + 半透明遮罩 */
.fn__pop {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.fn__bubble {
  max-width: 560rpx;
  background: #1f2329;
  color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}
.fn__text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #fff;
}
