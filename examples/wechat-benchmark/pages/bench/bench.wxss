.page { padding: 24rpx; }

.header { background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; }
.meta { color: #888; font-size: 24rpx; margin-top: 8rpx; }
.actions { margin-top: 16rpx; display: flex; gap: 16rpx; }

.stats {
  background: #fff; border-radius: 12rpx; padding: 16rpx 24rpx;
  margin-bottom: 24rpx; font-size: 26rpx;
}
.row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.row:last-child { border-bottom: 0; }
.header-row { color: #888; font-size: 22rpx; }
.col-name { flex: 1.2; }
.col-time { flex: 1; text-align: right; font-variant-numeric: tabular-nums; }
.col-trend { flex: 1; text-align: right; color: #888; font-size: 24rpx; }

.panels { display: flex; flex-direction: column; gap: 24rpx; }
.panel { background: #fff; border-radius: 12rpx; padding: 24rpx; }
.panel-title {
  font-size: 26rpx; color: #888; margin-bottom: 12rpx;
  padding-bottom: 8rpx; border-bottom: 1rpx solid #f0f0f0;
}

.footnote { color: #999; font-size: 22rpx; padding: 24rpx 8rpx 48rpx; line-height: 1.6; }
