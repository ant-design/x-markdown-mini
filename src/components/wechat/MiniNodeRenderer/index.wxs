var INLINE = { strong: 1, em: 1, del: 1, code: 1, a: 1, span: 1 };

function isInline(name) { return INLINE[name] === 1; }
function isText(name) { return name === 'text'; }
function isBr(name) { return name === 'br'; }
function isImg(name) { return name === 'img'; }
function isHr(name) { return name === 'hr'; }
function isPre(name) { return name === 'pre'; }
function isTable(name) { return name === 'table'; }
function isCopy(name) { return name === 'copy-button'; }
function isKatex(node) {
  var cls = (node.attrs || {})['class'] || '';
  return cls.indexOf('katex') > -1;
}
function toRichTextNode(node) {
  if (node.name === 'text') {
    return { type: 'text', text: (node.attrs || {}).value || '' };
  }
  if (node.name === 'br') {
    return { type: 'text', text: '\n' };
  }
  var result = { name: node.name };
  if (node.attrs) result.attrs = node.attrs;
  if (node.children && node.children.length) {
    result.children = toRichTextNodes(node.children);
  }
  return result;
}
function toRichTextNodes(nodes) {
  var result = [];
  for (var i = 0; i < (nodes || []).length; i++) {
    result.push(toRichTextNode(nodes[i]));
  }
  return result;
}
function copyOf(node) { return (node.attrs || {})['data-copy'] || ''; }
// 富内联节点（如 KaTeX 公式容器）含有元素子节点，必须走递归 <view> 路径
// 渲染，保留嵌套结构与 style；普通已扁平化的内联只有 text/br 子节点。
function isRich(node) {
  var ch = node.children;
  if (!ch) return false;
  for (var i = 0; i < ch.length; i++) {
    var nm = ch[i].name;
    if (nm !== 'text' && nm !== 'br') return true;
  }
  return false;
}
function isSlot(name, slotComponents) {
  return !!slotComponents && slotComponents.indexOf(name) > -1;
}

function classOf(node) {
  var attrs = node.attrs || {};
  var cls = attrs['class'] || '';
  if (node.animate) {
    cls = cls ? cls + ' md-animate-block' : 'md-animate-block';
  }
  return cls;
}

function styleOf(node) { return (node.attrs || {}).style || ''; }
function srcOf(node)   { return (node.attrs || {}).src || ''; }
function langOf(node)  { return (node.attrs || {}).lang || ''; }
function altOf(node)   { return (node.attrs || {}).alt || ''; }
function valueOf(node) { return (node.attrs || {}).value || ''; }
function tableShadowClass(shadows, key) {
  var state = shadows && shadows[key];
  if (!state) return '';
  var cls = '';
  if (state.left) cls += ' md-table-content--left-shadow';
  if (state.right) cls += ' md-table-content--right-shadow';
  return cls;
}

module.exports = {
  isInline: isInline,
  isText: isText,
  isBr: isBr,
  isImg: isImg,
  isHr: isHr,
  isPre: isPre,
  isTable: isTable,
  isCopy: isCopy,
  isKatex: isKatex,
  toRichTextNodes: toRichTextNodes,
  copyOf: copyOf,
  isRich: isRich,
  isSlot: isSlot,
  classOf: classOf,
  styleOf: styleOf,
  srcOf: srcOf,
  langOf: langOf,
  altOf: altOf,
  valueOf: valueOf,
  tableShadowClass: tableShadowClass,
};
