var INLINE = { strong: 1, em: 1, del: 1, code: 1, a: 1, span: 1 };

function isInline(name) { return INLINE[name] === 1; }
function isText(name) { return name === 'text'; }
function isBr(name) { return name === 'br'; }
function isImg(name) { return name === 'img'; }
function isHr(name) { return name === 'hr'; }
function isPre(name) { return name === 'pre'; }
function isTable(name) { return name === 'table'; }
function isCopy(name) { return name === 'copy-button'; }
function isDetails(name) { return name === 'details'; }
function summaryOf(node) { return (node.attrs || {}).summary || 'Details'; }
// Open state: a user toggle in detailsOpen[i] wins; otherwise fall back to
// the node's own `open` attribute (<details open>).
function detailsOpenState(map, key, node) {
  if (map && map[key] !== undefined) return !!map[key];
  return !!((node.attrs || {}).open);
}
function isKatex(node) {
  var cls = (node.attrs || {})['class'] || '';
  return cls.indexOf('katex') > -1;
}
// 列表项必须把 marker 与 content 作为 flex 容器（.md-list-item）的直接子节点渲染——
// WeChat 自定义组件宿主不是 flex 透明的，若 marker+content 共处一个嵌套渲染器宿主，
// flex 只看到一个子节点 → "1."/"•" 会单独占一行（支付宝 slot 宿主透明，故那端正常）。
function isListItem(node) {
  var cls = (node.attrs || {})['class'] || '';
  return cls.indexOf('md-list-item') > -1;
}
function toRichTextNode(node) {
  if (node.name === 'text') {
    return { type: 'text', text: (node.attrs || {}).value || '' };
  }
  if (node.name === 'br') {
    return { type: 'text', text: '\n' };
  }
  var result = { name: node.name };
  if (node.attrs) result.attrs = node.attrs;
  if (node.children && node.children.length) {
    result.children = toRichTextNodes(node.children);
  }
  return result;
}
function toRichTextNodes(nodes) {
  var result = [];
  for (var i = 0; i < (nodes || []).length; i++) {
    result.push(toRichTextNode(nodes[i]));
  }
  return result;
}
function copyOf(node) { return (node.attrs || {})['data-copy'] || ''; }
// 富内联节点（如 KaTeX 公式容器）含有元素子节点，必须走递归 <view> 路径
// 渲染，保留嵌套结构与 style；普通已扁平化的内联只有 text/br 子节点。
function isRich(node) {
  var ch = node.children;
  if (!ch) return false;
  for (var i = 0; i < ch.length; i++) {
    var nm = ch[i].name;
    if (nm !== 'text' && nm !== 'br') return true;
  }
  return false;
}
function isSlot(name, slotComponents) {
  return !!slotComponents && slotComponents.indexOf(name) > -1;
}

function classOf(node) {
  var attrs = node.attrs || {};
  var cls = attrs['class'] || '';
  if (node.animate) {
    cls = cls ? cls + ' md-animate-block' : 'md-animate-block';
  }
  return cls;
}

// 逐字/逐段动画拆出的叶子 <text> 用它取类名：把行内代码的「药丸盒」类换成纯字体类，
// 避免每个片段各自画一颗药丸（中间出现空隙）。盒模型只留在外层容器的 classOf 上。
function segClassOf(node) {
  var cls = classOf(node);
  if (cls.indexOf('md-inline-code') > -1) {
    cls = cls.replace('md-inline-code', 'md-inline-code-txt');
  }
  return cls;
}

function styleOf(node) { return (node.attrs || {}).style || ''; }
function srcOf(node)   { return (node.attrs || {}).src || ''; }
function langOf(node)  { return (node.attrs || {}).lang || ''; }
function altOf(node)   { return (node.attrs || {}).alt || ''; }
function valueOf(node) { return (node.attrs || {}).value || ''; }
// 边缘阴影：返回 overlay <view> 的可见修饰类（公用样式 markdownx-edge-shadow--visible）。
// shadows 按 data-table-key（=循环下标）索引，状态由 _measureTables / _tableScroll 计算。
function leftShadowClass(shadows, key) {
  var state = shadows && shadows[key];
  return state && state.left ? 'markdownx-edge-shadow--visible' : '';
}
function rightShadowClass(shadows, key) {
  var state = shadows && shadows[key];
  return state && state.right ? 'markdownx-edge-shadow--visible' : '';
}

module.exports = {
  isInline: isInline,
  isText: isText,
  isBr: isBr,
  isImg: isImg,
  isHr: isHr,
  isPre: isPre,
  isTable: isTable,
  isCopy: isCopy,
  isDetails: isDetails,
  summaryOf: summaryOf,
  detailsOpenState: detailsOpenState,
  isKatex: isKatex,
  isListItem: isListItem,
  leftShadowClass: leftShadowClass,
  rightShadowClass: rightShadowClass,
  toRichTextNodes: toRichTextNodes,
  copyOf: copyOf,
  isRich: isRich,
  isSlot: isSlot,
  classOf: classOf,
  segClassOf: segClassOf,
  styleOf: styleOf,
  srcOf: srcOf,
  langOf: langOf,
  altOf: altOf,
  valueOf: valueOf,
};
