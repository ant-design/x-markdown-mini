.md-root {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #1f1f1f;
  word-break: break-word;
}

.md-paragraph {
  display: block;
  margin: 0 0 16rpx;
}

.md-heading {
  display: block;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
  line-height: 1.3;
}
.md-h1 { font-size: 44rpx; }
.md-h2 { font-size: 38rpx; }
.md-h3 { font-size: 34rpx; }
.md-h4 { font-size: 30rpx; }
.md-h5 { font-size: 28rpx; }
.md-h6 { font-size: 26rpx; color: #666; }

.md-list {
  display: block;
  margin: 8rpx 0 16rpx;
  padding-left: 32rpx;
}
.md-list-item {
  display: list-item;
  margin: 4rpx 0;
}

.md-blockquote {
  display: block;
  margin: 12rpx 0;
  padding: 8rpx 16rpx;
  border-left: 6rpx solid #d9d9d9;
  color: #555;
  background: #fafafa;
}

.md-code-block {
  display: block;
  padding: 16rpx;
  background: #f6f8fa;
  overflow-x: auto;
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre;
}

/* code & table cards share a captioned header bar with an icon copy button */
.md-codeblock,
.md-tableblock {
  margin: 16rpx 0;
  border: 2rpx solid #eceef1;
  border-radius: 16rpx;
  overflow: hidden;
}
.md-codeblock-bar,
.md-tableblock-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
  padding: 0 24rpx;
  background: #f6f7f9;
  font-size: 24rpx;
  color: #8a8f99;
}
.md-codeblock-lang {
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-weight: 600;
}
.md-tableblock-title {
  font-weight: 600;
}
.md-copy-icon {
  width: 32rpx;
  height: 32rpx;
}

.md-code {
  display: block;
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  font-size: 26rpx;
  white-space: pre;
}

.md-inline-code {
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  font-size: 26rpx;
  background: #f3f3f3;
  padding: 0 6rpx;
  border-radius: 4rpx;
}

.md-strong { font-weight: 600; }
.md-em { font-style: italic; }

.md-link {
  color: #1677ff;
  text-decoration: underline;
}

.md-img {
  display: block;
  max-width: 100%;
  margin: 16rpx 0;
  border-radius: 12rpx;
}

.md-hr {
  display: block;
  height: 2rpx;
  background: #e5e5e5;
  margin: 16rpx 0;
}

/* table body scrolls horizontally inside the .md-tableblock card */
.md-table-scroll {
  display: block;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}
.md-table {
  display: table;
  table-layout: auto;
  width: max-content;
  min-width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 26rpx;
}
.md-tr { display: table-row; }
.md-th, .md-td {
  display: table-cell;
  padding: 12rpx 20rpx;
  max-width: 480rpx;
  border-right: 2rpx solid #e5e5e5;
  border-bottom: 2rpx solid #e5e5e5;
  text-align: left;
  vertical-align: top;
  word-break: break-word;
  white-space: normal;
}
.md-th { background: #fafafa; font-weight: 600; }
.md-tr .md-th:last-child,
.md-tr .md-td:last-child { border-right: none; }
.md-table .md-tr:last-child .md-td { border-bottom: none; }

.md-html { display: block; }
