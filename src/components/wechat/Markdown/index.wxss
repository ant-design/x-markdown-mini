.md-root {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #1f1f1f;
  word-break: break-word;
}

.md-paragraph {
  display: block;
  margin: 0 0 16rpx;
}

.md-heading {
  display: block;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
  line-height: 1.3;
}
.md-h1 { font-size: 44rpx; }
.md-h2 { font-size: 38rpx; }
.md-h3 { font-size: 34rpx; }
.md-h4 { font-size: 30rpx; }
.md-h5 { font-size: 28rpx; }
.md-h6 { font-size: 26rpx; color: #666; }

.md-list {
  display: block;
  margin: 8rpx 0 16rpx;
  padding-left: 32rpx;
}
.md-list-item {
  display: list-item;
  margin: 4rpx 0;
}

.md-blockquote {
  display: block;
  margin: 12rpx 0;
  padding: 8rpx 16rpx;
  border-left: 6rpx solid #d9d9d9;
  color: #555;
  background: #fafafa;
}

.md-code-block {
  display: block;
  padding: 16rpx;
  background: #f6f8fa;
  overflow-x: auto;
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre;
}

/* code block card: language label + copy toolbar wraps the scrollable body */
.md-codeblock {
  margin: 12rpx 0;
  border: 2rpx solid #e5e8ed;
  border-radius: 12rpx;
  overflow: hidden;
}
.md-codeblock-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 20rpx;
  background: #eef1f4;
  font-size: 22rpx;
  color: #8a8f99;
}
.md-codeblock-lang {
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.md-codeblock-copy {
  color: #1677ff;
  padding: 2rpx 10rpx;
}
.md-tableblock {
  margin: 24rpx 0;
}
.md-tableblock-bar {
  display: flex;
  justify-content: flex-end;
  padding: 0 0 8rpx;
}
.md-tableblock-copy {
  font-size: 22rpx;
  color: #1677ff;
  padding: 2rpx 10rpx;
}

.md-code {
  display: block;
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  font-size: 26rpx;
  white-space: pre;
}

.md-inline-code {
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  font-size: 26rpx;
  background: #f3f3f3;
  padding: 0 6rpx;
  border-radius: 4rpx;
}

.md-strong { font-weight: 600; }
.md-em { font-style: italic; }

.md-link {
  color: #1677ff;
  text-decoration: underline;
}

.md-img {
  display: block;
  max-width: 100%;
  margin: 16rpx 0;
  border-radius: 12rpx;
}

.md-hr {
  display: block;
  height: 2rpx;
  background: #e5e5e5;
  margin: 16rpx 0;
}

/* table: bordered card, scrolls horizontally when content overflows */
.md-table-scroll {
  display: block;
  width: 100%;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  overflow: hidden;
  white-space: nowrap;
}
.md-table {
  display: table;
  table-layout: auto;
  width: max-content;
  min-width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 26rpx;
}
.md-tr { display: table-row; }
.md-th, .md-td {
  display: table-cell;
  padding: 12rpx 20rpx;
  max-width: 480rpx;
  border-right: 2rpx solid #e5e5e5;
  border-bottom: 2rpx solid #e5e5e5;
  text-align: left;
  vertical-align: top;
  word-break: break-word;
  white-space: normal;
}
.md-th { background: #fafafa; font-weight: 600; }
.md-tr .md-th:last-child,
.md-tr .md-td:last-child { border-right: none; }
.md-table .md-tr:last-child .md-td { border-bottom: none; }

.md-html { display: block; }
