/* Dark syntax theme for mini-program code blocks. */
.md-codeblock {
  background: #111827;
  border: 1px solid #263244;
  border-radius: 8px;
  overflow: hidden;
}

.md-codeblock-bar {
  background: #172033;
  border-bottom: 1px solid #263244;
}

.md-codeblock-lang {
  color: #93c5fd;
  letter-spacing: 0;
  text-transform: uppercase;
}

.md-code-block {
  background: #111827;
  color: #dbeafe;
}

.hljs {
  color: #dbeafe;
  background: transparent;
}

.hljs-doctag,
.hljs-keyword,
.hljs-meta .hljs-keyword,
.hljs-template-tag,
.hljs-template-variable,
.hljs-type,
.hljs-variable.language_ {
  color: #f472b6;
}

.hljs-title,
.hljs-title.class_,
.hljs-title.class_.inherited__,
.hljs-title.function_ {
  color: #93c5fd;
}

.hljs-attr,
.hljs-attribute,
.hljs-literal,
.hljs-meta,
.hljs-number,
.hljs-operator,
.hljs-variable,
.hljs-selector-attr,
.hljs-selector-class,
.hljs-selector-id {
  color: #67e8f9;
}

.hljs-regexp,
.hljs-string,
.hljs-meta .hljs-string {
  color: #86efac;
}

.hljs-built_in,
.hljs-symbol {
  color: #fbbf24;
}

.hljs-comment,
.hljs-code,
.hljs-formula {
  color: #94a3b8;
}

.hljs-name,
.hljs-quote,
.hljs-selector-tag,
.hljs-selector-pseudo {
  color: #c4b5fd;
}

.hljs-subst {
  color: #dbeafe;
}

.hljs-section {
  color: #60a5fa;
  font-weight: bold;
}

.hljs-bullet {
  color: #fbbf24;
}

.hljs-emphasis {
  color: #dbeafe;
  font-style: italic;
}

.hljs-strong {
  color: #eff6ff;
  font-weight: bold;
}

.hljs-addition {
  color: #86efac;
  background-color: #052e16;
}

.hljs-deletion {
  color: #fca5a5;
  background-color: #450a0a;
}
